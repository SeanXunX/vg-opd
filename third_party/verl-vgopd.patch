index c900286a..77963117 100644
--- a/verl/trainer/distillation/fsdp/losses.py
+++ b/verl/trainer/distillation/fsdp/losses.py
@@ -62,6 +62,54 @@ def compute_forward_kl_topk(
         teacher_topk_ids = slice_input_tensor(teacher_topk_ids, dim=1)
     assert teacher_topk_log_probs.shape[:2] == teacher_topk_ids.shape[:2] == student_logits.shape[:2]
 
+    import os as _os
+
+    _chunk = int(_os.getenv("CROPD_TOPK_CHUNK", "0"))
+    if _chunk > 0:
+        from torch.utils.checkpoint import checkpoint as _ckpt
+
+        loss_config_c: DistillationLossConfig = config.distillation_loss
+
+        def _piece(logits_c, t_lp_c, t_id_c):
+            slp = F.log_softmax(logits_c, dim=-1)
+            s_topk = torch.gather(slp, dim=-1, index=t_id_c)
+            s_ids = torch.topk(slp, k=t_id_c.shape[-1], dim=-1).indices
+            s_mass = s_topk.exp().sum(dim=-1)
+            t_mass = t_lp_c.exp().sum(dim=-1)
+            s_topk_cl, t_lp_cl = s_topk, t_lp_c
+            if loss_config_c.log_prob_min_clamp is not None:
+                s_topk_cl = s_topk.clamp_min(loss_config_c.log_prob_min_clamp)
+                t_lp_cl = t_lp_c.clamp_min(loss_config_c.log_prob_min_clamp)
+            kl = kl_divergence(log_q=s_topk_cl, log_p=t_lp_cl)
+            ov = (t_id_c.unsqueeze(-1) == s_ids.unsqueeze(-2)).any(dim=-1)
+            ovc = ov.sum(dim=-1)
+            tkl = t_lp_cl.exp() * (t_lp_cl - s_topk_cl)
+            oa_sum = (-tkl * ov).sum(dim=-1)
+            oa = torch.where(ovc > 0, oa_sum / ovc.clamp_min(1), torch.zeros_like(oa_sum))
+            return kl, s_mass, t_mass, ovc.to(kl.dtype), oa
+
+        _bufs = [[], [], [], [], []]
+        _T = student_logits.shape[1]
+        for _s in range(0, _T, _chunk):
+            _e = min(_s + _chunk, _T)
+            _pieces = _ckpt(
+                _piece,
+                student_logits[:, _s:_e],
+                teacher_topk_log_probs[:, _s:_e],
+                teacher_topk_ids[:, _s:_e].long(),
+                use_reentrant=False,
+            )
+            for _b, _p in zip(_bufs, _pieces):
+                _b.append(_p)
+        _kl, _sm, _tm, _oc, _oa = (torch.cat(_b, dim=1) for _b in _bufs)
+        return {
+            "distillation_losses": _kl,
+            "student_mass": _sm,
+            "teacher_mass": _tm,
+            "overlap_count": _oc,
+            "overlap_token_advantage": _oa,
+        }
+
     # 2. compute token-wise KL divergence across sp groups
     student_log_probs = F.log_softmax(student_logits, dim=-1)
     student_topk_ids = torch.topk(student_log_probs, k=teacher_topk_ids.shape[-1], dim=-1).indices
